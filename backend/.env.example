# Copy to .env and fill in. Never commit .env.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Supabase → Project Settings → Database → Connection string (use the "Session pooler" URI).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only secret, used to sign image upload URLs. Never put it in the app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Only for older projects still on the legacy shared JWT secret. Leave empty to verify tokens with the project's JWKS.
SUPABASE_JWT_SECRET=

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# One-time secret to create the first gym and its admin (POST /v1/setup). Remove after use.
SETUP_TOKEN=change-me-to-a-long-random-string

# Background jobs (stale check-ins, membership reminders). Turn off on extra instances.
JOBS_ENABLED=true
